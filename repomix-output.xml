<file path="app/Http/Controllers/Cliente/PedidoController.php">
<?php

namespace App\Http\Controllers\Cliente;

use App\Http\Controllers\Controller;
use App\Models\DetallePedido;
use App\Models\Pago;
use App\Models\Pedido;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;

class PedidoController extends Controller
{
    public function procesar(Request $request)
    {
        $carrito = session()->get('carrito', []);

        if (empty($carrito)) {
            return redirect()->route('cliente.catalogo')
                ->with('error', 'Tu carrito está vacío.');
        }

        $request->validate([
            'tipo_entrega' => 'required|in:recoger_local,contraentrega',
            'metodo_pago' => 'required|in:efectivo,qr',
            'direccion' => 'required_if:tipo_entrega,contraentrega|nullable|string|max:255',
            'referencia' => 'nullable|string|max:255',
            'latitud' => 'nullable|numeric',
            'longitud' => 'nullable|numeric',
        ]);

        $total = 0;
        foreach ($carrito as $item) {
            $total += $item['precio'] * $item['cantidad'];
        }

        try {
            // Iniciamos la transacción. Si algo falla, todo se revierte (Rollback).
            DB::beginTransaction();

            $pedido = Pedido::create([
                'usuario_id' => auth()->id(),
                'total' => $total,
                'estado' => 'pendiente',
                'metodo_pago' => $request->metodo_pago,
                'tipo_entrega' => $request->tipo_entrega,
                'direccion' => $request->direccion ?? null,
                'referencia' => $request->referencia ?? null,
                'latitud' => $request->latitud ?? null,
                'longitud' => $request->longitud ?? null,
            ]);

            foreach ($carrito as $item) {
                DetallePedido::create([
                    'pedido_id' => $pedido->id,
                    'producto_id' => $item['producto_id'],
                    'cantidad' => $item['cantidad'],
                    'precio_unitario' => $item['precio'],
                ]);
            }

            Pago::create([
                'pedido_id' => $pedido->id,
                'monto' => $total,
                'metodo' => $request->metodo_pago,
                'estado_pago' => 'pendiente',
                'codigo_qr' => null,
            ]);

            // Si todo salió bien, confirmamos los cambios en la BD
            DB::commit();

            session()->forget('carrito');

            return redirect()
                ->route('cliente.seguimiento', $pedido->id)
                ->with('success', '¡Pedido creado correctamente!');
        } catch (\Exception $e) {
            // Si hay un error, deshacemos todo
            DB::rollBack();

            return redirect()->back()
                ->with('error', 'Ocurrió un error al procesar tu pedido. Inténtalo de nuevo.')
                ->withInput();
        }
    }

    public function cancelar($pedidoId)
    {
        $pedido = Pedido::findOrFail($pedidoId);

        if ($pedido->usuario_id !== auth()->id()) {
            abort(403, 'No tienes permiso para cancelar este pedido.');
        }

        if ($pedido->estado !== 'pendiente') {
            return redirect()->back()->with('error', 'Este pedido ya no se puede cancelar.');
        }

        $pedido->update(['estado' => 'cancelado']);

        return redirect()->route('cliente.mis_pedidos')
            ->with('success', 'Pedido cancelado correctamente.');
    }

    public function misPedidos()
    {
        $pedidos = Pedido::where('usuario_id', auth()->id())
            ->with(['detallePedidos.producto', 'pago'])
            ->orderBy('created_at', 'desc')
            ->paginate(10);

        return view('cliente.mis-pedidos', compact('pedidos'));
    }
}
</file>

<file path="app/Http/Controllers/ProfileController.php">
<?php

namespace App\Http\Controllers;

use App\Http\Requests\ProfileUpdateRequest;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Redirect;
use Illuminate\View\View;

class ProfileController extends Controller
{
    public function edit(Request $request): View
    {
        return view('profile.edit', [
            'user' => $request->user(),
        ]);
    }

    public function update(ProfileUpdateRequest $request): RedirectResponse
    {
        DB::transaction(function () use ($request) {
            $user = $request->user();

            // 1. Actualizamos la tabla usuarios (solo email)
            $user->email = $request->validated('email');

            if ($user->isDirty('email')) {
                $user->email_verified_at = null;
            }
            $user->save();

            // 2. Actualizamos la tabla clientes (perfil)
            $user->cliente()->updateOrCreate(
                ['usuario_id' => $user->id],
                [
                    'nombres' => $request->validated('nombres'),
                    'apellidos' => $request->validated('apellidos'),
                    'telefono' => $request->validated('telefono'),
                    'direccion_entrega' => $request->validated('direccion_entrega'),
                    'latitud' => $request->validated('latitud'),
                    'longitud' => $request->validated('longitud'),
                ]
            );
        });

        return Redirect::route('cliente.perfil')->with('status', 'profile-updated');
    }

    public function destroy(Request $request): RedirectResponse
    {
        $request->validateWithBag('userDeletion', [
            'password' => ['required', 'current_password'],
        ]);

        $user = $request->user();

        Auth::logout();

        $user->delete();

        $request->session()->invalidate();
        $request->session()->regenerateToken();

        return Redirect::to('/');
    }
}
